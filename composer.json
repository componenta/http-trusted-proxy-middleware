{
    "name": "componenta/http-trusted-proxy-middleware",
    "description": "Trusted proxy PSR-15 middleware for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "ext-ctype": "*"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\TrustedProxy\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit tests"
    }
}
